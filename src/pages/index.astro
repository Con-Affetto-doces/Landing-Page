---
import SiteLayout from "../layouts/SiteLayout.astro";
import Cardapio from "../components/Cardapio.astro";
import Marca from "../components/Marca.astro";
import { contato } from "../data/contato";
---

<SiteLayout>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

  <div class="page-shell">
    <header class="page-header" id="inicio">
      <div class="container header-content">
        <a class="brand" href="#inicio" aria-label="Con Affetto, início">
          <Marca variante="principal-inverso" />
        </a>
        <nav aria-label="Navegação principal">
          <a href="#cardapio">Cardápio</a>
          <a href="#nossa-historia">Nossa história</a>
          <a class="header-order" href="#encomendas">Encomendas</a>
        </nav>
      </div>
    </header>

    <main id="conteudo" tabindex="-1">
      <section class="hero" aria-labelledby="titulo-principal">
        <div class="container hero-content">
          <div class="hero-copy">
            <h1 id="titulo-principal">Biscoitos decorados e tradicionais.</h1>
            <p class="hero-description">Biscoitos artesanais são a especialidade da Con Affetto. Também preparamos doces variados.</p>
            <div class="hero-actions">
              <a class="button" href="#cardapio">Ver cardápio <span aria-hidden="true">↓</span></a>
              <a class="text-link" href={contato.whatsapp.url}>Encomendas pelo WhatsApp <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <figure class="hero-visual">
            <img
              src="/assets/imagens/biscoitos-decorados-mock-1120.webp"
              srcset="/assets/imagens/biscoitos-decorados-mock-640.webp 640w, /assets/imagens/biscoitos-decorados-mock-1120.webp 1120w"
              sizes="(max-width: 600px) 90vw, (max-width: 900px) 520px, (max-width: 1280px) 45vw, (max-width: 1599px) 540px, 640px"
              width="1120"
              height="1400"
              alt="Ilustração de biscoitos decorados em rosa e violeta e biscoitos tradicionais sobre um prato."
              fetchpriority="high"
            >
            <figcaption>Imagem ilustrativa</figcaption>
          </figure>
        </div>
      </section>

      <Cardapio />

      <div class="closing-section">
        <div class="container closing-sheet">
          <section class="story-section" id="nossa-historia" aria-labelledby="titulo-historia">
            <h2 id="titulo-historia">Nossa história</h2>
            <p>A Con Affetto nasceu do amor de Maria pela confeitaria e das receitas que aprendeu com a família.</p>
          </section>

          <section class="contact-section" id="encomendas" aria-labelledby="titulo-encomendas">
            <h2 id="titulo-encomendas">Encomendas</h2>
            <div class="contact-action">
              <a class="button" href={contato.whatsapp.url}>Falar pelo WhatsApp <span aria-hidden="true">↗</span></a>
              <p class="contact-number">{contato.whatsapp.numero}</p>
            </div>
          </section>
        </div>
      </div>
    </main>

    <footer class="page-footer">
      <div class="container footer-content">
        <a class="brand footer-brand" href="#inicio" aria-label="Con Affetto, início">
          <Marca variante="principal-inverso" />
        </a>
        <nav aria-label="Navegação do rodapé">
          <a href={contato.instagram.url}>Instagram · {contato.instagram.usuario} <span aria-hidden="true">↗</span></a>
          <a class="footer-return" href="#inicio">Voltar ao início <span aria-hidden="true">↑</span></a>
        </nav>
      </div>
    </footer>
  </div>
</SiteLayout>

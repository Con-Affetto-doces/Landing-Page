---
import { biscoitos, pipocas } from "../data/cardapio";
import ItemCardapio from "./ItemCardapio.astro";
import Marca from "./Marca.astro";
import { contato } from "../data/contato";
---

<section class="menu-section" id="cardapio" aria-labelledby="titulo-cardapio">
  <div class="container menu-sheet">
    <div class="menu-heading">
      <h2 id="titulo-cardapio">Cardápio</h2>
      <Marca variante="simbolo" class="menu-symbol" />
    </div>

    <div class="menu-columns">
      <section class="biscuit-menu" id="biscoitos" aria-labelledby="titulo-biscoitos">
        <h3 id="titulo-biscoitos">Biscoitos</h3>
        <ul class="product-list biscuit-list">
          {biscoitos.map((produto) => <ItemCardapio {...produto} />)}
        </ul>
      </section>

      <section class="sweets-menu" id="doces" aria-labelledby="titulo-doces">
        <h3 id="titulo-doces">Doces variados</h3>
        <p>As pipocas gourmet também fazem parte da nossa seleção de doces.</p>
        <section class="popcorn-menu" id="pipocas" aria-labelledby="titulo-pipocas">
          <h4 id="titulo-pipocas">Pipocas gourmet</h4>
          <ul class="product-list popcorn-list">
            {pipocas.map((produto) => <ItemCardapio {...produto} />)}
          </ul>
        </section>
      </section>
    </div>

    <div class="menu-footer">
      <a class="text-link" href={contato.whatsapp.url}>Encomendas pelo WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
